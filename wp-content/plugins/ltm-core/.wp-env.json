{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.5",
	"plugins": [
		"."
	],
	"mappings": {
		"wp-content/plugins": ".."
	},
	"themes": [ "../../themes/latitudemedia" ],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false
	},
	"env": {
		"tests": {
			"config": {
				"WP_DEBUG": true,
				"WP_DEBUG_DISPLAY": false
			}
		}
	},
	"lifecycleScripts": {
		"afterStart": "./bin/wp-env-after-start.sh"
	}
}
