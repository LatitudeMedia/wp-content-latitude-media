{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "latitudemedia/featured-post-block",
  "title": "Featured Post",
  "category": "ltm-common-blocks",
  "icon": "star-filled",
  "description": "Highlight a single post as a featured card, optionally scoped to the page's sponsor.",
  "keywords": [ "featured", "post", "sponsor" ],
  "textdomain": "ltm",
  "style": "file:../../../dist/css/blocks/featured-post-block.min.css",
  "attributes": {
    "postId": {
      "type": "number",
      "default": 0
    },
    "isSponsored": {
      "type": "boolean",
      "default": false
    },
    "excludeFromOtherBlocks": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  }
}
