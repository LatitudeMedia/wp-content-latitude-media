{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "latitudemedia/news-type-preview",
	"version": "0.1.0",
	"title": "News Type Preview",
	"category": "ltm-common-blocks",
	"icon": "megaphone",
	"description": "List published posts by News Type, optionally narrowed to one podcast show.",
	"keywords": [ "news type", "podcast", "posts", "listing" ],
	"example": {},
	"attributes": {
		"newsType": {
			"type": "string",
			"default": "news"
		},
		"podcastId": {
			"type": "number",
			"default": 0
		},
		"numberOfPosts": {
			"type": "number",
			"default": 5
		}
	},
	"supports": {
		"html": false,
		"anchor": true
	},
	"textdomain": "ltm",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
