{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "latitudemedia/subscriber-form",
	"version": "0.1.0",
	"title": "Subscriber Form",
	"category": "ltm-common-blocks",
	"icon": "email-alt2",
	"description": "Newsletter signup form with a title, disclaimer, and embeddable form code.",
	"keywords": [ "form", "subscribe", "newsletter", "signup", "hubspot" ],
	"example": {},
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"disclaimer": {
			"type": "string",
			"default": ""
		},
		"embedCode": {
			"type": "string",
			"default": ""
		},
		"layout": {
			"type": "string",
			"enum": [ "square" ],
			"default": "square"
		}
	},
	"supports": {
		"html": false,
		"anchor": true
	},
	"textdomain": "ltm",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
