{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "latitudemedia/title-block",
  "title": "Title Block",
  "category": "ltm-page-custom-blocks",
  "icon": "cover-image",
  "description": "Full-bleed page title header with a kicker, background image, and sponsor logo.",
  "keywords": [ "title", "hero", "thematic page" ],
  "textdomain": "ltm",
  "attributes": {
    "kicker": {
      "type": "string",
      "default": ""
    },
    "backgroundImageId": {
      "type": "number",
      "default": 0
    },
    "backgroundImageUrl": {
      "type": "string",
      "default": ""
    },
    "sponsorLogoOverrideId": {
      "type": "number",
      "default": 0
    },
    "sponsorLogoOverrideUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  }
}
